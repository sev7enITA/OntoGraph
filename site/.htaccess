RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.openontograph\.org$ [NC]
RewriteRule ^ https://openontograph.org%{REQUEST_URI} [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^?\ ]*/)?index\.html(?:[?\ ]|$) [NC]
RewriteRule ^(.*/)?index\.html$ https://openontograph.org/$1 [R=301,L]
RewriteRule ^studio/?$ https://www.fabriziodegni.com/OntoGraph/ [R=302,L]
